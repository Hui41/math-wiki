{
  "files.associations": {
    "*.wiki": "latex"
  },
  "editor.quickSuggestions": {
  "other": "on",
  "comments": "off",
  "strings": "on"
},
"editor.suggestOnTriggerCharacters": true,
  "editor.wordWrap": "on",
  "editor.tabCompletion": "on",


  "livePreview.serverRoot": "_site",
